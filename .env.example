# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# MongoDB Atlas connection string (replace <db_password> with your real password).
MONGODB_URI=mongodb+srv://tanmoy:<db_password>@tanmoy.dbot4ve.mongodb.net/?appName=Tanmoy
MONGODB_DB=career_counselling

# Google Gemini API keys (the app rotates across these on rate-limit / failure).
# Paste your real keys here ONLY in your local .env, never in this example file.
GEMINI_API_KEY_1=your-gemini-key-1
GEMINI_API_KEY_2=your-gemini-key-2
GEMINI_API_KEY_3=your-gemini-key-3

# Local port (Render injects its own PORT automatically).
PORT=8080
